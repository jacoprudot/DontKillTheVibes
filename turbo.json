{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["src/**", "tests/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "security:audit": {
      "inputs": ["src/**", "SECURITY.md"]
    }
  }
}
