# github-log-pattern-6 positive: the production log level is pinned to debug/trace in BOTH
# spellings — the compact one and the spaced one people actually write — so this file MUST
# fire. The spaced assignment below is the shape defect 1 missed: the pattern carried a
# literal 's' where the whitespace class was meant, so a spaced assignment measured 0.
NODE_ENV=production
LOG_LEVEL=debug
log_level = "trace"
LOG_FORMAT=json
