# security-debug-in-prod-1 POSITIVE — the anchored pattern must fire on EVERY
# line of a consecutive run, and must report the line the flag is ON (not the one
# before it).
#
# WHY THIS FILE EXISTS: the first version of the anchored pattern used
# `(?:^|\n)`, which CONSUMES the newline. Two consequences, both measured:
#   - the reported line was the previous line and the evidence was EMPTY
#     (26 findings in the 2026-10-08 sweep, none of them readable), and
#   - only the FIRST of two consecutive flags matched, because the match had
#     already eaten the second line's anchor.
# The pattern now anchors with `(?<=^|\n)` (a lookbehind consumes nothing) and
# scripts/detect/{engine,matchers}.mjs startOfLine() no longer treats a match that
# starts on a newline as an empty line. This file is the case that regresses if
# either half is undone.

DEBUG=1
DEBUG=true

app.debug = True
