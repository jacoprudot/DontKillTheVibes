      "content": "<!doctype html><html><head><meta charset=\"utf-8\"><title>HOLO — hand-gesture control deck</title>\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<style>\r\n  * { margin:0; padding:0; box-sizing:border-box; }\r\n  html,body { height:100%; overflow:hidden; background:#05070a; font-family:-apple-system,\"Segoe UI\",sans-serif; }\r\n  /* v3 layers: the CAMERA IS THE STAGE (bright), everything floats on it */\r\n  #cam { position:fixed; inset:0; width:100%; height:100%; object-fit:cover; z-index:1;\r\n         transform:scaleX(-1); opacity:.55; filter:saturate(.85) brightness(.95); transition:opacity .4s; }\r\n  #vignette { position:fixed; inset:0; z-index:2; pointer-events:none;\r\n         background:radial-gradient(ellipse at center, transparent 40%, rgba(4,6,9,.55) 100%); }\r\n  #stars { position:fixed; inset:0; z-index:2; pointer-events:none; opacity:.5; }\r\n  #deck { position:fixed; inset:0; z-index:3; perspective:1200px; }\r\n  .card { position:absolute; width:230px; min-height:110px; max-height:200px; overflow:hidden;\r\n          padding:14px 16px; border-radius:14px; will-change:transform;\r\n          background:rgba(12,18,24,.78); border:1px solid rgba(120,255,214,.25);\r\n          backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);\r\n          box-shadow:0 14px 44px rgba(0,0,0,.5); transition:border-color .12s, box-shadow .12s; }\r\n  .card h3 { font-family:\"SF Mono\",ui-monospace,Menlo,monospace; font-size:12.5px; letter-spacing:.08em;\r\n             color:#a9ffe6; font-weight:600; margin-bottom:7px; text-transform:uppercase; }\r\n  .card p { font-size:11px; line-height:1.55; color:#c9d6d2; white-space:pre-wrap; }\r\n  .orb { position:absolute; width:150px; height:150px; border-radius:50%; will-change:transform;\r\n         display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;\r\n         background:radial-gradient(circle at 38% 32%, rgba(60,110,96,.5), rgba(10,18,22,.72) 70%);\r\n         border:1.5px solid rgba(125,255,217,.5); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);\r\n         box-shadow:0 10px 40px rgba(0,0,0,.5), inset 0 0 30px rgba(90,255,215,.12);\r\n         transition:border-color .12s, box-shadow .12s; }\r\n  .orb h3 { font-family:\"SF Mono\",ui-monospace,monospace; font-size:12px; letter-spacing:.18em;\r\n            color:#d9fff2; font-weight:700; }\r\n  .orb span { font-family:\"SF Mono\",ui-monospace,monospace; font-size:9px; letter-spacing:.1em; color:#8fd8c2; }\r\n  .orb.openf { opacity:.55; border-style:dashed; }\r\n  .hover { border-color:#9dffe4 !important;\r\n           box-shadow:0 18px 60px rgba(0,0,0,.55), 0 0 54px rgba(110,255,222,.75),\r\n                      inset 0 0 22px rgba(110,255,222,.18) !important; }\r\n  .grab  { border-color:#7dffd9 !important;\r\n           box-shadow:0 22px 70px rgba(0,0,0,.6), 0 0 50px rgba(110,255,220,.5) !important; }\r\n  .docked { border-color:rgba(240,200,100,.55) !important; }\r\n  /* width/height 100% is LOAD-BEARING: a canvas is a REPLACED element — inset:0 does\r\n     NOT stretch it, it falls back to its intrinsic (2×-retina) buffer size. Without\r\n     this the GL layer is double-sized on any dpr=2 screen and the objects render\r\n     off the visible quarter (invisible on retina, perfect in dpr=1 headless). */\r\n  #gl { position:fixed; inset:0; width:100%; height:100%; z-index:3; pointer-events:none; }\r\n  #hud { position:fixed; inset:0; z-index:4; pointer-events:none; }\r\n  /* the ACTIVE ring, top-left — the status jewel */\r\n  #ring { position:fixed; left:34px; top:70px; z-index:4; width:150px; height:150px; pointer-events:none; }\r\n  #ring .r1 { position:absolute; inset:0; border-radius:50%; border:2px solid rgba(125,255,217,.65);\r\n              box-shadow:0 0 24px rgba(125,255,217,.25), inset 0 0 24px rgba(125,255,217,.12);\r\n              animation:spin 14s linear infinite; border-top-color:transparent; }\r\n  .card p { font-size:11px; }\r\n  #ring .r2 { position:absolute; inset:12px; border-radius:50%; border:1px dashed rgba(125,255,217,.4);\r\n              animation:spin 9s linear infinite reverse; }\r\n  #ring .mid { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;\r\n               justify-content:center; gap:5px; }\r\n  #ring .mid b { font-family:\"SF Mono\",ui-monospace,monospace; font-size:11px; letter-spacing:.3em;\r\n               color:#eafff8; font-weight:700; }\r\n  #ring .mid i { font-family:\"SF Mono\",ui-monospace,monospace; font-size:8.5px; letter-spacing:.4em;\r\n               color:#7dffd9; font-style:normal; }\r\n  @keyframes spin { to { transform:rotate(360deg); } }\r\n  /* ---------- JARVIS MODE (V7 preview): gold skin + spoken-line captions ---------- */\r\n  body.jarvis #ring .r1 { border-color:rgba(255,204,110,.75); border-top-color:transparent;\r\n    box-shadow:0 0 26px rgba(255,196,90,.28), inset 0 0 26px rgba(255,196,90,.14); }\r\n  body.jarvis #ring .r2 { border:1px solid rgba(255,204,110,.42); animation-duration:5s; }\r\n  body.jarvis #ring .mid b { color:#ffe9c4; }\r\n  body.jarvis #ring .mid i { color:#ffcf7d; }\r\n  body.jarvis #title { color:#ffe9c4; }\r\n  body.jarvis #jarvis { color:#ffcf7d !important; border-color:rgba(255,204,110,.55) !important;\r\n    box-shadow:0 0 18px rgba(255,196,90,.18); }\r\n  body.jarvis.speaking #ring .r1 { animation:spin 14s linear infinite, jbreathe 1.05s ease-in-out infinite; }\r\n  @keyframes jbreathe { 50% { box-shadow:0 0 46px rgba(255,196,90,.55), inset 0 0 34px rgba(255,196,90,.3); } }\r\n  #caption { position:fixed; left:50%; bottom:84px; transform:translateX(-50%) translateY(8px); z-index:6;\r\n    max-width:min(760px, 84vw); padding:10px 22px; border-radius:12px; text-align:center;\r\n    font-family:\"SF Mono\",ui-monospace,monospace; font-size:13px; letter-spacing:.1em; line-height:1.6;\r\n    color:#ffe9c4; background:rgba(10,14,18,.72); border:1px solid rgba(255,204,110,.3);\r\n    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);\r\n    text-shadow:0 0 14px rgba(255,196,90,.35); opacity:0; pointer-events:none;\r\n    transition:opacity .25s, transform .25s; }\r\n  #caption.show { opacity:1; transform:translateX(-50%) translateY(0); }\r\n  .tldr { position:absolute; width:270px; padding:13px 15px; border-radius:13px; z-index:4;\r\n    background:rgba(14,18,22,.86); border:1px solid rgba(255,204,110,.5);\r\n    box-shadow:0 16px 50px rgba(0,0,0,.55), 0 0 30px rgba(255,196,90,.22);\r\n    backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);\r\n    opacity:0; transform:scale(.9); transition:opacity .3s, transform .3s; pointer-events:none; }\r\n  .tldr.show { opacity:1; transform:scale(1); }\r\n  .tldr b { display:block; font-family:\"SF Mono\",ui-monospace,monospace; font-size:10.5px;\r\n    letter-spacing:.14em; color:#ffcf7d; margin-bottom:6px; }\r\n  .tldr p { font-size:11px; line-height:1.55; color:#e8dfc8; }\r\n  #legend { position:fixed; left:20px; bottom:20px; z-index:5; pointer-events:none;\r\n    font-family:\"SF Mono\",ui-monospace,monospace; font-size:10px; letter-spacing:.09em;\r\n    line-height:2; color:#8fd8c2; background:rgba(8,14,18,.74); border:1px solid rgba(125,255,217,.22);\r\n    border-radius:12px; padding:9px 15px; }\r\n  #legend b { color:#7dffd9; font-weight:600; }\r\n  #ui { position:fixed; z-index:5; left:0; right:0; top:0; display:flex; align-items:center;\r\n        gap:14px; padding:14px 20px; pointer-events:none; }\r\n  #ui .chip { pointer-events:auto; font-family:\"SF Mono\",ui-monospace,monospace; font-size:11px;\r\n        letter-spacing:.14em; padding:8px 16px; border-radius:99px; cursor:pointer; user-select:none;\r\n        color:#7dffd9; background:rgba(10,16,20,.7); border:1px solid rgba(125,255,217,.35); }\r\n  #ui .chip.off { color:#8a97a0; border-color:rgba(255,255,255,.14); }\r\n  #title { font-family:\"SF Mono\",ui-monospace,monospace; color:#e8fff7; font-size:13px; letter-spacing:.3em; }\r\n  #status { margin-left:auto; font-family:\"SF Mono\",ui-monospace,monospace; font-size:10.5px;\r\n            letter-spacing:.12em; color:#9fb4ab; text-shadow:0 1px 4px rgba(0,0,0,.8); }\r\n  #dock { position:fixed; right:0; top:10%; bottom:10%; width:74px; z-index:2; pointer-events:none;\r\n          border-left:1px dashed rgba(240,200,100,.3); background:linear-gradient(270deg, rgba(240,200,100,.07), transparent); }\r\n  #dock span { position:absolute; top:50%; right:26px; transform:rotate(90deg) translateX(-50%); transform-origin:right;\r\n          font-family:\"SF Mono\",ui-monospace,monospace; font-size:9px; letter-spacing:.4em; color:rgba(240,200,100,.6); }\r\n  #reader { position:fixed; inset:0; z-index:6; display:none; align-items:center; justify-content:center;\r\n            background:rgba(4,6,9,.6); backdrop-filter:blur(5px); }\r\n  #reader .pane { width:min(680px, 82vw); max-height:74vh; overflow:auto; padding:34px 40px;\r\n            border-radius:20px; background:rgba(12,18,24,.94); border:1px solid rgba(125,255,217,.45);\r\n            box-shadow:0 30px 90px rgba(0,0,0,.7); }\r\n  #reader h2 { font-family:\"SF Mono\",ui-monospace,monospace; font-size:17px; letter-spacing:.12em;\r\n            color:#a9ffe6; text-transform:uppercase; margin-bottom:16px; }\r\n  #reader pre { font-family:-apple-system,\"Segoe UI\",sans-serif; font-size:14px; line-height:1.75;\r\n            color:#dce8e4; white-space:pre-wrap; }\r\n  #reader .hint { margin-top:20px; font-family:\"SF Mono\",ui-monospace,monospace; font-size:10px;\r\n            letter-spacing:.2em; color:#5a6b62; }\r\n  #dbg { position:fixed; left:20px; bottom:18px; z-index:6; display:none; pointer-events:none;\r\n         font-family:\"SF Mono\",ui-monospace,monospace; font-size:10.5px; line-height:1.8;\r\n         color:#7dffd9; background:rgba(8,12,16,.85); border:1px solid rgba(125,255,217,.3);\r\n         border-radius:10px; padding:10px 14px; white-space:pre; }\r\n  #perm { position:fixed; inset:0; z-index:7; display:none; align-items:center; justify-content:center;\r\n          background:rgba(5,7,10,.86); }\r\n  #perm .box { max-width:420px; text-align:center; color:#c9d6d2; font-size:13.5px; line-height:1.7;\r\n          background:rgba(14,20,26,.9\n... [truncated, file is 89824 bytes]"
