  "findings": [
    {
      "id": "security-cve-critical-1",
      "module": "github",
      "severity": "critical",
      "location": {
        "file": "docker/Dockerfile",
        "line": 1
      },
      "description": "The base image node:22-bookworm is referenced by a floating tag with no digest pin, so a compromised or vulnerable base image can be pulled silently at build time.",
      "remediation": "Pin the base image to a specific digest and rebuild deliberately when the base is updated.",
      "effort": "S",
      "confidence": 0.4
    },
    {
      "id": "security-oauth-secret-8",
      "module": "github",
      "severity": "critical",
      "location": {
        "file": "src/docker/container.py",
        "line": 0
      },
      "description": "The container manager copies the host ~/.claude.json (which contains OAuth/session credentials) into the run workspace, so credentials are duplicated into a directory that may be shared or archived with the run.",
      "remediation": "Avoid copying the full host config; generate a minimal per-run config containing only the required non-secret settings.",
      "effort": "XS",
      "confidence": 0.4
    },
    {
      "id": "cost-db-growth-3",
      "module": "cost",
      "severity": "medium",
      "location": {
        "file": "examples/kernel_engineering_trimul_strict/hidden_eval_dir/_ttt_lib/libkernelbot/backend.py",
        "line": 0
      },
      "description": "Every submission writes a submission row plus one submission_run row per run key (including full compilation, result, and system payloads) with no retention, archiving, or pruning policy, so the database grows unbounded with evaluation artifacts.",
      "remediation": "Add a retention/archival policy for submission and submission_run records (e.g. archive or prune detailed run payloads after N days) and monitor table growth.",
      "effort": "M",
      "confidence": 0.5
    },
    {
      "id": "flows-message-ordering-needed-4",
      "module": "flows",
      "severity": "medium",
      "location": {
        "file": "src/monitor/server.py",
        "line": 0
      },
      "description": "The SSE endpoint drains the bridge queue and yields events in queue order, but events are also written to pipeline state and files independently; there is no sequence number or ordering guarantee across the SSE stream, the pipeline state file, and the snapshot. A client merging these sources can observe out-of-order stage/score updates.",
      "remediation": "Attach a monotonically increasing sequence number to each pushed event and to pipeline-state writes, and have the monitor order/deduplicate by that sequence so consumers see a consistent event order.",
      "effort": "M",
      "confidence": 0.4
    },
    {
      "id": "flows-message-retention-too-short-6",
      "module": "flows",
      "severity": "medium",
      "location": {
        "file": "src/monitor/data.py",
        "line": 0
      },
      "description": "The scan cache uses a 2-second TTL (_SCAN_TTL = 2.0), so expensive stage-result scans are recomputed frequently during active polling. This is a retention/refresh tuning issue: the cache is too short-lived to absorb the polling load it was added for, causing repeated filesystem scans.",
      "remediation": "Increase the scan cache TTL (or invalidate it on file mtime change instead of a fixed short TTL) so repeated monitor polls reuse scan results rather than rescanning the workspace every couple of seconds.",
      "effort": "M",
      "confidence": 0.4
    },
    {
      "id": "security-binary-dep-10",
      "module": "github",
      "severity": "medium",
      "location": {
        "file": "docker/Dockerfile",
        "line": 3
      },
      "description": "The Dockerfile installs a large set of system libraries and the Claude Code CLI from unpinned apt and npm sources, so binary dependencies can change or be compromised between builds.",
      "remediation": "Pin apt package versions and the npm CLI version, and verify checksums where possible.",
      "effort": "M",
      "confidence": 0.4
    },
    {
      "id": "security-gha-job-no-timeout-7",
      "module": "github",
      "severity": "medium",
      "location": {
        "file": "docker/build.sh",
        "line": 12
      },
      "description": "The docker build is invoked without any timeout or retry bound, so a hung network fetch during the build can block indefinitely with no upper limit on execution time.",
      "remediation": "Wrap the docker build in a bounded timeout (e.g. `timeout 1800 docker build ...`) and fail fast with a clear error when the limit is exceeded.",
      "effort": "M",
      "confidence": 0.4
    },
    {
      "id": "flows-no-time-travel-9",
      "module": "flows",
      "severity": "low",
      "location": {
        "file": "src/runtime.py",
        "line": 0
      },
      "description": "Pipeline state is written by mutating a JSON file in place (read existing, update keys, rewrite), with no event log or history of prior states. There is no way to replay or inspect the sequence of state transitions that led to the current pipeline state, which hampers debugging of stuck or misrouted runs.",
      "remediation": "Append each pipeline-state transition to an append-only JSONL history (with timestamp and stage) in addition to the current-state file, so the run's state evolution can be replayed and inspected.",
      "effort": "S",
      "confidence": 0.4
    }
  ],
