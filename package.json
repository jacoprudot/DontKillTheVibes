{
  "name": "dontkillthevibes",
  "version": "0.1.0-beta",
  "description": "LLM-orchestrated assessment toolkit for vibe coders",
  "author": "Jacobo Prudot (Jaco) <jaco@leongael.xyz>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=./mcps/*",
    "test": "turbo run test --filter=./mcps/*",
    "security:audit": "turbo run security:audit --filter=./mcps/*",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:mcps": "node scripts/validate-mcps.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^20.0.0",
    "ts-node": "^10.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dontkillthevibes": {
    "skillSchemaVersion": "1.0",
    "mcpProtocolVersion": "2024-11-05",
    "minLlmCapabilities": ["tool-use", "structured-output"]
  }
}
